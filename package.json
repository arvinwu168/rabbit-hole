{
  "name": "rabbit-hole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "relay": "node scripts/chatgpt-relay.mjs",
    "relay:login": "node scripts/chatgpt-relay.mjs --login",
    "relay:report": "node scripts/relay-report.mjs",
    "test": "npm run test:rabbit-hole && npm run test:inference && npm run test:relay",
    "test:rabbit-hole": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/rabbit-hole.test.mjs",
    "test:inference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/inference-options.test.mjs",
    "test:relay": "node --test scripts/chatgpt-relay.test.mjs scripts/relay-observability.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.52",
    "ai": "^7.0.65",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "^6.0.3"
  }
